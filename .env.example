# A-Eye configuration — copy to `.env` and edit. `.env` is gitignored.
# Everything here is optional; A-Eye runs fully local with these defaults.

# Where A-Eye stores videos, frames/thumbnails, and cached indexes.
# AEYE_DATA_DIR=~/.aeye

# Local model serving (Ollama).
# AEYE_OLLAMA_HOST=http://localhost:11434
# AEYE_VISION_MODEL=qwen2.5vl:7b
# AEYE_CHAT_MODEL=qwen2.5vl:7b
# AEYE_WHISPER_MODEL=large-v3-turbo

# Provider per role: ollama (local) | anthropic | openai
# AEYE_VISION_PROVIDER=ollama
# AEYE_CHAT_PROVIDER=ollama

# Optional BYOK cloud keys — used only if you select a cloud provider above.
# These are read from the standard env vars and never committed. See docs/providers.md.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
